{
  "id": "open-telemark-wing",
  "name": {"ja": "オープン・テレマーク・フォロード・バイ・ウイング", "en": "Open Telemark followed by Wing"},
  "dance": "waltz",
  "timeSignature": "3/4",
  "parts": {
    "man": {
      "steps": [
        { "stepNo": 1, "foot": "L", "stepDescription": {"move": "forward"}, "count": "1", "beats": 1,
          "footwork": "HT", "alignment": {"relation": "facing", "direction": "DC"},
          "amountOfTurn": {"direction": "none", "amount": "0"}, "riseAndFall": "commence_rise_eo_1",
          "sway": "straight", "cbm": true,
          "note": {"ja": "1で左回転を始める", "en": "Commence to turn L on 1"} },
        { "stepNo": 2, "foot": "R", "stepDescription": {"move": "side"}, "count": "2", "beats": 1,
          "footwork": "T", "alignment": {"relation": "backing", "direction": "DW"},
          "amountOfTurn": {"direction": "left", "amount": "1/4", "between": [1, 2]}, "riseAndFall": "up",
          "sway": "L", "cbm": false },
        { "stepNo": 3, "foot": "L", "stepDescription": {"move": "side", "modifiers": ["slightly_back", "in_PP"]}, "count": "3", "beats": 1,
          "footwork": "TH", "alignment": {"relation": "pointing", "direction": "DW"},
          "amountOfTurn": {"direction": "left", "amount": "1/2", "between": [2, 3]}, "riseAndFall": "up_lower_eo_3",
          "sway": "straight", "cbm": false,
          "note": {"ja": "体は壁に面して。ボディの回転は少なめ", "en": "Body facing wall. Body turns less"} },
        { "stepNo": 4, "foot": "R", "stepDescription": {"move": "forward_PP", "modifiers": ["in_CBMP", "across", "strong_step"]}, "count": "1", "beats": 1,
          "footwork": "H", "alignment": {"relation": "pointing", "direction": "LOD"},
          "amountOfTurn": {"direction": "left", "amount": "1/8", "between": [3, 4]}, "riseAndFall": "down",
          "sway": "straight", "cbm": false },
        { "stepNo": 5, "foot": "L", "stepDescription": {"move": "begin_close"}, "count": "2", "beats": 1,
          "footwork": "flat", "alignment": {"relation": "facing", "direction": "DC"},
          "amountOfTurn": {"direction": "none", "amount": "0"}, "riseAndFall": "rise_slightly_2_3_nfr",
          "sway": "straight", "cbm": false,
          "note": {"ja": "右足フット・フラット、Tでプレッシャー。6のアラインメントの方へ。5で体を左に回転", "en": "RF whole foot flat, pressure on T. Toward alignment of 6. Body turns L on 5"} },
        { "stepNo": 6, "foot": "L", "stepDescription": {"move": "close_no_weight"}, "count": "3", "beats": 1,
          "footwork": "T_IE", "alignment": {"relation": "facing", "direction": "DC"},
          "amountOfTurn": {"direction": "left", "amount": "1/8", "between": [5, 6]}, "riseAndFall": "rise_slightly_2_3_nfr",
          "sway": "straight", "cbm": false,
          "note": {"ja": "左足TのIEでプレッシャー", "en": "Pressure on IE of LF toe"} }
      ]
    },
    "lady": {
      "steps": [
        { "stepNo": 1, "foot": "R", "stepDescription": {"move": "back"}, "count": "1", "beats": 1,
          "footwork": "TH", "alignment": {"relation": "backing", "direction": "DC"},
          "amountOfTurn": {"direction": "none", "amount": "0"}, "riseAndFall": "commence_rise_slightly_eo_1_nfr",
          "sway": "straight", "cbm": true,
          "note": {"ja": "1で左回転を始める", "en": "Commence to turn L on 1"} },
        { "stepNo": 2, "foot": "L", "stepDescription": {"move": "close", "modifiers": ["heel_turn"]}, "count": "2", "beats": 1,
          "footwork": "HT", "alignment": {"relation": "facing", "direction": "LOD"},
          "amountOfTurn": {"direction": "left", "amount": "3/8", "between": [1, 2]}, "riseAndFall": "continue_rise",
          "sway": "R", "cbm": false },
        { "stepNo": 3, "foot": "R", "stepDescription": {"move": "forward", "modifiers": ["slightly_side", "in_PP", "shoulder_lead"]}, "count": "3", "beats": 1,
          "footwork": "TH", "alignment": {"relation": "pointing", "direction": "LOD"},
          "amountOfTurn": {"direction": "none", "amount": "0"}, "riseAndFall": "up_lower_eo_3",
          "sway": "straight", "cbm": false,
          "note": {"ja": "右SL。3で体を少し左に回転", "en": "R shoulder lead. Body turns slightly L on 3"} },
        { "stepNo": 4, "foot": "L", "stepDescription": {"move": "forward_PP", "modifiers": ["in_CBMP"]}, "count": "1", "beats": 1,
          "footwork": "HT", "alignment": {"relation": "facing", "direction": "DC"},
          "amountOfTurn": {"direction": "left", "amount": "1/8", "between": [3, 4]}, "riseAndFall": "down_commence_rise_eo_1",
          "sway": "straight", "cbm": true },
        { "stepNo": 5, "foot": "R", "stepDescription": {"move": "forward", "modifiers": ["preparing_left_OP"]}, "count": "2", "beats": 1,
          "footwork": "T", "alignment": {"relation": "facing", "direction": "centre"},
          "amountOfTurn": {"direction": "left", "amount": "1/8", "between": [4, 5]}, "riseAndFall": "continue_rise",
          "sway": "L", "cbm": false },
        { "stepNo": 6, "foot": "L", "stepDescription": {"move": "forward", "modifiers": ["left_outside_partner", "in_CBMP"]}, "count": "3", "beats": 1,
          "footwork": "TH", "alignment": {"relation": "facing", "direction": "against_LOD"},
          "amountOfTurn": {"direction": "left", "amount": "1/4", "between": [5, 6]}, "riseAndFall": "up_lower_eo_3",
          "sway": "L", "cbm": false }
      ]
    }
  }
}
