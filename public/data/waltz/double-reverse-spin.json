          "footwork": "T", "alignment": {"relation": "backing", "direction": "wall"},
          "amountOfTurn": {"direction": "left", "amount": "1/4", "between": [2, 3]}, "riseAndFall": "up",
          "sway": "straight", "cbm": false },
        { "stepNo": 4, "foot": "L", "stepDescription": {"move": "cross_front"}, "count": "3", "beats": 1,
          "footwork": "TH", "alignment": {"relation": "backing", "direction": "DW"},
          "amountOfTurn": {"direction": "left", "amount": "1/8", "between": [3, 4]}, "riseAndFall": "up_lower_eo_3",
          "sway": "straight", "cbm": false }
