          "sway": "straight", "cbm": true,
          "note": {"ja": "1で左回転を始める", "en": "Commence to turn L on 1"} },
        { "stepNo": 2, "foot": "R", "stepDescription": {"move": "side"}, "count": "2&", "beats": 1,
          "footwork": "T", "alignment": {"relation": "backing", "direction": "DW"},
          "amountOfTurn": {"direction": "left", "amount": "3/8", "between": [1, 2]}, "riseAndFall": "up",
